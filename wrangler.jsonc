{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "every-dog-in-new-york",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/live"],
  },
  "durable_objects": { "bindings": [{ "name": "CITY", "class_name": "City" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["City"] }],
  "routes": [{ "pattern": "everydog.nyc", "custom_domain": true }],
}
