{
  "name": "every-dog-in-new-york",
  "description": "Every Dog in New York: 96,459 licensed dogs, by neighborhood",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Firat Ciftci (https://www.firatciftci.com)",
  "homepage": "https://everydog.nyc",
  "repository": "github:firatciftci/every-dog-in-new-york",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3010",
    "dev:live": "wrangler dev --port 8787",
    "prepare": "svelte-kit sync || echo ''",
    "build": "vite build",
    "preview": "vite preview --port 3010",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:rules": "vitest --run --project rules",
    "lint": "knip && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --concurrency auto .",
    "lint:fix": "knip --fix && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --concurrency auto --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "ci": "pnpm run check && pnpm run format && pnpm run lint && pnpm run test",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "bits-ui": "^2.19.5",
    "maplibre-gl": "^6.14.0",
    "mode-watcher": "^1.1.0",
    "runed": "^0.37.1",
    "svelte-maplibre": "^2.0.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/browser-playwright": "^5.0.3",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "eslint-plugin-inline-utilities": "^1.0.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.1",
    "knip": "^6.41.0",
    "oxfmt": "^0.72.0",
    "playwright": "^1.64.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.11.2",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
