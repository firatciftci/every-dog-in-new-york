{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "schedule:monthly"
  ],
  "timezone": "America/New_York",
  "rangeStrategy": "bump",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["* 0-3 1 * *"] },
  "packageRules": [
    {
      "description": "pnpm refuses npm releases younger than a day, so Renovate waits as long.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Mirrors minimumReleaseAgeExclude in pnpm-workspace.yaml.",
      "matchPackageNames": [
        "@sveltejs/**",
        "eslint-plugin-svelte",
        "pnpm",
        "shadcn-svelte",
        "svelte",
        "svelte-check"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "groupName": "npm non-major dependencies",
      "groupSlug": "npm-minor-patch",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "Python non-major dependencies",
      "groupSlug": "python-minor-patch",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    { "groupName": "GitHub Actions", "matchManagers": ["github-actions"] },
    {
      "description": "requires-python is a floor, and .python-version moves only when the pipeline is tested on a new Python.",
      "matchDepNames": ["python"],
      "matchManagers": ["pep621", "pyenv"],
      "enabled": false
    },
    {
      "description": "Keep .nvmrc on the major line so it follows every Node 24 release.",
      "matchManagers": ["nvm"],
      "rangeStrategy": "replace"
    },
    {
      "groupName": "Svelte",
      "matchPackageNames": ["svelte", "svelte-check", "@sveltejs/**"],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "ESLint",
      "matchPackageNames": [
        "eslint",
        "@antfu/eslint-config",
        "eslint-plugin-*"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "runed carries a pnpm patch pinned to 0.37.1; rebase the patch before taking a new version.",
      "matchPackageNames": ["runed"],
      "dependencyDashboardApproval": true
    }
  ]
}
